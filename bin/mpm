#!/bin/bash
# ==============================================================================
# MPM (Modern Package Manager)
# Fully Isolated, Self-Contained, Rootless Package Environments
# ==============================================================================

set -e

BASE_DIR="$HOME/.local_apt"
ENVS_GLOBAL_DIR="$HOME/.local/share/mpm/environments"
CACHE_DIR="$HOME/.cache/mpm/archives"

APT_STATE="$BASE_DIR/lists"
APT_CACHE="$BASE_DIR/cache"
APT_ETC="$BASE_DIR/etc"
SOURCES_LIST="$APT_ETC/sources.list"
SOURCES_D="$APT_ETC/sources.list.d"

ARCH=$(dpkg --print-architecture 2>/dev/null || echo "amd64")
DETECTED_CODENAME=$(lsb_release -cs 2>/dev/null || grep UBUNTU_CODENAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')

if [ "$DETECTED_CODENAME" = "resolute" ] || [ -z "$DETECTED_CODENAME" ]; then
    CODENAME="noble"
else
    CODENAME="$DETECTED_CODENAME"
fi

MIRROR="http://archive.ubuntu.com/ubuntu"

TARGET_ENV=""
VERBOSE=false

get_target_prefix() {
    if [ -n "$TARGET_ENV" ]; then
        echo "$ENVS_GLOBAL_DIR/$TARGET_ENV"
    elif [ -n "$MPM_ACTIVE_PREFIX" ]; then
        echo "$MPM_ACTIVE_PREFIX"
    else
        echo "$(pwd)/.mpm"
    fi
}

log_verbose() {
    if [ "$VERBOSE" = true ]; then
        echo -e "  \033[90m[DEBUG]\033[0m $1"
    fi
}

init_apt_env() {
    mkdir -p "$APT_STATE/partial" \
             "$APT_CACHE/archives/partial" \
             "$APT_ETC" \
             "$SOURCES_D" \
             "$CACHE_DIR" \
             "$ENVS_GLOBAL_DIR"

    if [ -f /var/lib/dpkg/status ]; then
        STATUS_FILE="/var/lib/dpkg/status"
    else
        STATUS_FILE="$BASE_DIR/status"
        touch "$STATUS_FILE"
    fi
}

get_apt_opts() {
    APT_OPTS=(
        -o Dir::State::Lists="$APT_STATE"
        -o Dir::State::status="$STATUS_FILE"
        -o Dir::Cache="$APT_CACHE"
        -o Dir::Cache::archives="$APT_CACHE/archives"
        -o Dir::Etc::sourcelist="$SOURCES_LIST"
        -o Dir::Etc::sourceparts="/dev/null"
    )
}

# ==========================================
# ENVIRONMENT CREATION & ACTIVATION WRAPPER
# ==========================================
setup_environment_scaffold() {
    local prefix="$1"
    mkdir -p "$prefix/bin" "$prefix/lib" "$prefix/usr/bin" "$prefix/usr/lib" "$prefix/share"

    cat << 'EOF' > "$prefix/activate"
deactivate () {
    if [ -n "${_OLD_MPM_PATH:-}" ]; then
        PATH="${_OLD_MPM_PATH:-}"
        export PATH
        unset _OLD_MPM_PATH
    fi
    if [ -n "${_OLD_MPM_LD_PATH:-}" ]; then
        LD_LIBRARY_PATH="${_OLD_MPM_LD_PATH:-}"
        export LD_LIBRARY_PATH
        unset _OLD_MPM_LD_PATH
    else
        unset LD_LIBRARY_PATH 2>/dev/null || true
    fi
    if [ -n "${_OLD_MPM_PS1:-}" ]; then
        PS1="${_OLD_MPM_PS1:-}"
        export PS1
        unset _OLD_MPM_PS1
    fi
    unset MPM_ACTIVE_PREFIX
    if [ -n "${BASH:-}" -o -n "${ZSH_VERSION:-}" ]; then
        hash -r 2>/dev/null || true
    fi
}

# If already in an active environment, deactivate it first to prevent prompt stacking
if [ -n "${MPM_ACTIVE_PREFIX:-}" ]; then
    deactivate
fi

_OLD_MPM_PATH="$PATH"
_OLD_MPM_LD_PATH="${LD_LIBRARY_PATH:-}"
_OLD_MPM_PS1="${PS1:-}"

ENV_BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export MPM_ACTIVE_PREFIX="$ENV_BASE"

# Auto-discover all library folders inside this isolated environment
RAW_LIBS=$(find "$ENV_BASE" -type d \( -name "lib" -o -name "*linux-gnu" \) 2>/dev/null | tr '\n' ':')
CLEAN_LIBS="${RAW_LIBS%:}"

if [ -n "$CLEAN_LIBS" ]; then
    export LD_LIBRARY_PATH="${CLEAN_LIBS}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export PATH="$ENV_BASE/bin:$ENV_BASE/usr/bin:$ENV_BASE/usr/games:$PATH"

# Cleanly prepend prompt indicator without stacking
PS1="($(basename "$ENV_BASE")) ${PS1:-}"
export PS1
EOF
    chmod +x "$prefix/activate"
}

# ==========================================
# UV-STYLE PARALLEL ASYNC ENGINE
# ==========================================
parallel_download() {
    local target_cache="$1"
    local is_verbose="$2"
    shift 2
    local urls=("$@")

    python3 - "${target_cache}" "${is_verbose}" "${urls[@]}" << 'EOF'
import sys, os, time, threading
from urllib.request import urlopen, Request

cache_dir = sys.argv[1]
verbose = (sys.argv[2].lower() == "true")
urls = sys.argv[3:]

total_files = len(urls)
completed_files = 0
lock = threading.Lock()

tasks = {}
for u in urls:
    fname = os.path.basename(u.split('?')[0])
    pkg_name = fname.split('_')[0] if '_' in fname else fname
    cached = os.path.exists(os.path.join(cache_dir, fname))
    tasks[u] = {
        'name': pkg_name[:20],
        'file': fname,
        'downloaded': 0,
        'total': 0,
        'done': cached,
        'cached': cached,
        'active': False
    }
    if cached:
        completed_files += 1

def human_bytes(b):
    if b <= 0: return "  0.00   B"
    units = ["B", "KiB", "MiB", "GiB"]
    idx = 0
    val = float(b)
    while val >= 1024.0 and idx < len(units) - 1:
        val /= 1024.0
        idx += 1
    return f"{val:6.2f} {units[idx]}"

def worker(url):
    global completed_files
    if tasks[url]['done']:
        if verbose:
            print(f"  \033[90m[CACHE HIT]\033[0m {tasks[url]['name']}")
        return

    out_path = os.path.join(cache_dir, tasks[url]['file'])
    part_path = out_path + ".part"

    with lock:
        tasks[url]['active'] = True

    try:
        req = Request(url, headers={'User-Agent': 'mpm/2.0'})
        with urlopen(req, timeout=30) as resp, open(part_path, 'wb') as f:
            total_size = int(resp.headers.get('Content-Length', 0))
            with lock:
                tasks[url]['total'] = total_size

            chunk_size = 64 * 1024
            while True:
                chunk = resp.read(chunk_size)
                if not chunk:
                    break
                f.write(chunk)
                with lock:
                    tasks[url]['downloaded'] += len(chunk)
        os.rename(part_path, out_path)
    except Exception as e:
        if verbose:
            print(f"  \033[31m[ERROR]\033[0m {url}: {e}")
        if os.path.exists(part_path):
            os.remove(part_path)
    finally:
        with lock:
            tasks[url]['done'] = True
            tasks[url]['active'] = False
            completed_files += 1

MAX_WORKERS = 8
threads = []
for u in urls:
    t = threading.Thread(target=worker, args=(u,), daemon=True)
    threads.append(t)

SPINNER = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
spin_idx = 0

for t in threads:
    while len([th for th in threads if th.is_alive()]) >= MAX_WORKERS:
        time.sleep(0.04)
    t.start()

if not verbose:
    sys.stdout.write("\033[?25l")
    sys.stdout.flush()

last_rendered_lines = 0

try:
    while completed_files < total_files:
        if verbose:
            time.sleep(0.2)
            continue

        spin_idx = (spin_idx + 1) % len(SPINNER)
        char = SPINNER[spin_idx]

        with lock:
            header = f"\033[1;36m{char}\033[0m \033[1mFetching packages...\033[0m ({completed_files}/{total_files})\n"
            lines = [header]
            active_items = [v for v in tasks.values() if v['active']]
            
            for item in active_items[:4]:
                cur = human_bytes(item['downloaded'])
                tot = human_bytes(item['total']) if item['total'] > 0 else "  ?.?? MiB"
                bar_len = 22
                if item['total'] > 0:
                    pct = min(1.0, item['downloaded'] / item['total'])
                    filled = int(bar_len * pct)
                    bar = "━" * filled + "╸" + "━" * (bar_len - filled - 1) if filled < bar_len else "━" * bar_len
                else:
                    bar = "━" * bar_len

                lines.append(f"  \033[32m{item['name']:<20}\033[0m \033[90m{bar}\033[0m {cur}/{tot}\n")

        if last_rendered_lines > 0:
            sys.stdout.write(f"\033[{last_rendered_lines}A\033[J")
        sys.stdout.write("".join(lines))
        sys.stdout.flush()
        last_rendered_lines = len(lines)
        time.sleep(0.08)
finally:
    if not verbose:
        if last_rendered_lines > 0:
            sys.stdout.write(f"\033[{last_rendered_lines}A\033[J")
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()

print(f"\033[32m✔\033[0m Synchronized {total_files} packages.")
EOF
}

# ==========================================
# 1. UPDATE SUBCOMMAND
# ==========================================
do_update() {
    init_apt_env
    get_apt_opts
    
    echo "Updating indices for [$CODENAME] ($ARCH) via wget..."
    > "$SOURCES_LIST"

    POCKETS=("$CODENAME" "${CODENAME}-updates" "${CODENAME}-security")
    COMPONENTS=("main" "universe" "restricted" "multiverse")
    PREFIX="archive.ubuntu.com_ubuntu_dists"

    for pocket in "${POCKETS[@]}"; do
        echo "deb $MIRROR $pocket ${COMPONENTS[*]}" >> "$SOURCES_LIST"
        for comp in "${COMPONENTS[@]}"; do
            TARGET="${APT_STATE}/${PREFIX}_${pocket}_${comp}_binary-${ARCH}_Packages"
            URL_XZ="${MIRROR}/dists/${pocket}/${comp}/binary-${ARCH}/Packages.xz"
            URL_GZ="${MIRROR}/dists/${pocket}/${comp}/binary-${ARCH}/Packages.gz"

            echo -n "Fetching: ${pocket}/${comp}... "
            if wget -q --spider "$URL_XZ" 2>/dev/null; then
                wget -q -O - "$URL_XZ" | xz -d > "$TARGET" 2>/dev/null
                echo -e "\e[32m[OK (xz)]\e[0m"
            elif wget -q --spider "$URL_GZ" 2>/dev/null; then
                wget -q -O - "$URL_GZ" | gzip -d > "$TARGET" 2>/dev/null
                echo -e "\e[32m[OK (gz)]\e[0m"
            else
                rm -f "$TARGET"
                echo -e "\e[90m[Not Found]\e[0m"
            fi
        done
    done
    echo "Update complete! Verified package lists stored in $APT_STATE"
}

# ==========================================
# 2. INSTALL SUBCOMMAND
# ==========================================
do_install() {
    local PACKAGE="$1"
    [ -z "$PACKAGE" ] && { echo "Usage: mpm install [-n <env>] <package>"; exit 1; }

    init_apt_env
    get_apt_opts

    local PREFIX
    PREFIX="$(get_target_prefix)"
    setup_environment_scaffold "$PREFIX"

    echo -e "\e[1;36m⠹\e[0m Resolving dependencies for \e[1m$PACKAGE\e[0m..."
    log_verbose "Target prefix: $PREFIX"

    set +e
    RAW_OUTPUT=$(/usr/bin/apt-get "${APT_OPTS[@]}" install --reinstall --no-install-recommends --print-uris -qq "$PACKAGE" 2>&1)
    APT_CODE=$?
    set -e

    if [ $APT_CODE -ne 0 ]; then
        echo -e "\e[31mError resolving packages.\e[0m apt said:"
        echo "$RAW_OUTPUT"
        exit 1
    fi

    readarray -t URLS < <(echo "$RAW_OUTPUT" | cut -d"'" -f2 | grep '\.deb$')

    if [ ${#URLS[@]} -eq 0 ]; then
        echo "No packages found to install."
        exit 1
    fi

    parallel_download "$CACHE_DIR" "$VERBOSE" "${URLS[@]}"

    echo -e "\e[1;36m⠹\e[0m Extracting into isolated environment (\e[1m$PREFIX\e[0m)..."
    for u in "${URLS[@]}"; do
        local deb_name
        deb_name=$(basename "${u%%\?*}")
        local deb_path="$CACHE_DIR/$deb_name"
        [ -f "$deb_path" ] || continue

        dpkg -x "$deb_path" "$PREFIX"
    done

    # Symlink binaries inside this environment's bin/
    mkdir -p "$PREFIX/bin"
    for search_dir in "$PREFIX/usr/bin" "$PREFIX/usr/games" "$PREFIX/usr/sbin"; do
        [ -d "$search_dir" ] || continue
        for bin in "$search_dir"/*; do
            [ -f "$bin" ] && [ -x "$bin" ] || continue
            local bname
            bname=$(basename "$bin")
            ln -sf "$bin" "$PREFIX/bin/$bname"
        done
    done

    if command -v patchelf &>/dev/null; then
        log_verbose "Patching environment RPATHs with patchelf..."
        local rpath="\$ORIGIN/../lib:\$ORIGIN/../lib/x86_64-linux-gnu:\$ORIGIN/../../usr/lib:\$ORIGIN/../../usr/lib/x86_64-linux-gnu"
        
        set +e
        for elf in "$PREFIX"/bin/* "$PREFIX"/usr/bin/*; do
            if [ -f "$elf" ] && [ ! -h "$elf" ]; then
                if head -c 4 "$elf" 2>/dev/null | grep -q $'\x7fELF'; then
                    patchelf --set-rpath "$rpath" "$elf" 2>/dev/null
                fi
            fi
        done
        
        for lib in "$PREFIX"/lib/x86_64-linux-gnu/*.so* "$PREFIX"/usr/lib/x86_64-linux-gnu/*.so*; do
            if [ -f "$lib" ] && [ ! -h "$lib" ]; then
                if head -c 4 "$lib" 2>/dev/null | grep -q $'\x7fELF'; then
                    patchelf --set-rpath "\$ORIGIN:\$ORIGIN/..:$rpath" "$lib" 2>/dev/null
                fi
            fi
        done
        set -e
    fi

    setup_environment_scaffold "$PREFIX"

    echo "------------------------------------------------"
    echo -e "\e[32m✔ SUCCESS:\e[0m \e[1m$PACKAGE\e[0m installed into $PREFIX"
    echo ""
    echo "To run commands in this environment:"
    echo -e "  \e[33mmpm run $PACKAGE [args...]\e[0m"
    echo "Or activate it:"
    echo -e "  \e[33mmpm activate\e[0m (or source $PREFIX/activate)"
}

# ==========================================
# 3. RUN SUBCOMMAND
# ==========================================
do_run() {
    local PREFIX
    PREFIX="$(get_target_prefix)"

    if [ ! -d "$PREFIX" ]; then
        echo "Error: Environment $PREFIX not found. Run 'mpm install' or 'mpm init' first."
        exit 1
    fi

    local raw_libs
    raw_libs=$(find "$PREFIX" -type d \( -name "lib" -o -name "*linux-gnu" \) 2>/dev/null | tr '\n' ':')
    local clean_libs="${raw_libs%:}"

    exec env \
        PATH="$PREFIX/bin:$PREFIX/usr/bin:$PATH" \
        LD_LIBRARY_PATH="${clean_libs}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        PKG_CONFIG_PATH="$PREFIX/lib/pkgconfig:$PREFIX/usr/lib/pkgconfig:${PKG_CONFIG_PATH:-}" \
        "$@"
}

# ==========================================
# 4. SEARCH SUBCOMMAND
# ==========================================
do_search() {
    local QUERY="$1"
    [ -z "$QUERY" ] && { echo "Usage: mpm search <query>"; exit 1; }
    init_apt_env
    get_apt_opts
    /usr/bin/apt-cache "${APT_OPTS[@]}" search "$QUERY" | awk '{printf "\033[32m%-25s\033[0m %s\n", $1, substr($0, index($0,$2))}'
}

# ==========================================
# 5. ENV / INIT SUBCOMMANDS
# ==========================================
do_init() {
    local PREFIX
    PREFIX="$(get_target_prefix)"
    setup_environment_scaffold "$PREFIX"
    echo -e "\e[32m✔\e[0m Initialized isolated environment in \e[1m$PREFIX\e[0m"
    echo "Activate with: mpm activate"
}

# ==========================================
# 6. SHELL HOOK INTEGRATION
# ==========================================
do_shell_hook() {
    cat << 'EOF'
mpm() {
    if [ "$1" = "activate" ]; then
        shift
        local target_env="$1"
        local env_path=""
        if [ -n "$target_env" ]; then
            env_path="$HOME/.local/share/mpm/environments/$target_env"
        elif [ -d "./.mpm" ]; then
            env_path="$(pwd)/.mpm"
        else
            echo "Error: No .mpm environment found in current directory." >&2
            return 1
        fi

        if [ -f "$env_path/activate" ]; then
            source "$env_path/activate"
        else
            echo "Error: Activation script not found at $env_path/activate" >&2
            return 1
        fi
    elif [ "$1" = "deactivate" ]; then
        if type deactivate >/dev/null 2>&1; then
            deactivate
        else
            echo "Error: No active mpm environment to deactivate." >&2
            return 1
        fi
    else
        command mpm "$@"
    fi
}
EOF
}

# ==========================================
# CLI PARSER DISPATCHER
# ==========================================
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -n|--env)
            TARGET_ENV="$2"
            shift 2
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

set -- "${ARGS[@]}"
COMMAND="$1"
shift || true

case "$COMMAND" in
    init)        do_init ;;
    update)      do_update ;;
    search)      do_search "$1" ;;
    install)     do_install "$1" ;;
    run)         do_run "$@" ;;
    clean)       rm -rf "${CACHE_DIR:?}"/* && echo "Cache cleaned." ;;
    shell-hook)  do_shell_hook ;;
    activate)
        echo "Notice: To activate environments directly with 'mpm activate', run:"
        echo '  eval "$(mpm shell-hook)"'
        echo "Or source the file directly:"
        echo "  source .mpm/activate"
        ;;
    *)
        echo "MPM: Modern Rootless Package Manager (Isolated Environments)"
        echo "Usage: mpm [-v] [-n <env-name>] <command> [args]"
        echo ""
        echo "Commands:"
        echo "  init                    Initialize a local .mpm/ environment (or -n <name>)"
        echo "  install <package>       Install package into local .mpm/ (or -n <name>)"
        echo "  run <command> [args]    Run executable inside the environment"
        echo "  search <query>          Search package in remote indices"
        echo "  update                  Update index cache"
        echo "  clean                   Clear downloaded .deb cache"
        echo "  shell-hook              Generate shell integration code for mpm activate"
        ;;
esac